class Assumption:
    type_id: ClassVar[str]
    @classmethod
    def compatible_padic_complex_lift(cls, prime: int, precision: int) -> Assumption: ...
    @classmethod
    def exact_padic_differential_ranks(cls, outgoing: int, incoming: int) -> Assumption: ...
    @classmethod
    def generalized_riemann_hypothesis(cls) -> Assumption: ...
    @classmethod
    def regular_sequence(cls) -> Assumption: ...
    @classmethod
    def smooth_complete_intersection(cls) -> Assumption: ...
    @classmethod
    def torsion_order_is_smooth(cls, bound: int) -> Assumption: ...
    @classmethod
    def squarefree(cls, cofactor: int) -> Assumption: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> Assumption: ...

class MathematicalValidity:
    type_id: ClassVar[str]
    @classmethod
    def unconditional(cls) -> MathematicalValidity: ...
    @classmethod
    def conditional(cls, assumptions: list[Assumption]) -> MathematicalValidity: ...
    @property
    def is_unconditional(self) -> bool: ...
    @property
    def assumptions(self) -> list[Assumption]: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> MathematicalValidity: ...

Z: IntegerRing
Q: RationalField
__version__: str
