from collections.abc import Sequence
from typing import ClassVar

from noether import IntegerRing
from noether.combin import Poset
from noether.groups import Permutation, PermutationGroup
from noether.homalg import ChainComplex, FinitelyGeneratedAbelianGroup, GradedHomology

class AtomId:
    def __init__(self, degree: int, index: int) -> None: ...
    @property
    def degree(self) -> int: ...
    @property
    def index(self) -> int: ...

class SignedBoundary:
    def __init__(
        self,
        negative: Sequence[int] = ...,
        positive: Sequence[int] = ...,
    ) -> None: ...
    @property
    def negative(self) -> list[int]: ...
    @property
    def positive(self) -> list[int]: ...

class SteinerCell:
    def apply_automorphism(self, automorphism: Permutation) -> SteinerCell: ...
    @property
    def category(self) -> SteinerCategory: ...
    @property
    def dimension(self) -> int: ...
    @property
    def intrinsic_dimension(self) -> int: ...
    @property
    def is_identity(self) -> bool: ...
    @property
    def top_atoms(self) -> list[int]: ...
    @property
    def negative_supports(self) -> list[list[int]]: ...
    @property
    def positive_supports(self) -> list[list[int]]: ...
    @property
    def source(self) -> SteinerCell: ...
    @property
    def target(self) -> SteinerCell: ...
    def identity(self) -> SteinerCell: ...
    def source_at(self, dimension: int) -> SteinerCell: ...
    def target_at(self, dimension: int) -> SteinerCell: ...
    def compose_at(self, next: SteinerCell, dimension: int) -> SteinerCell: ...

class SteinerCanonicalLabel:
    @property
    def category(self) -> SteinerCategory: ...
    @property
    def labeling(self) -> Permutation: ...
    @property
    def degreewise_labeling(self) -> list[list[int]]: ...
    @property
    def encoding(self) -> list[int]: ...
    @property
    def automorphism_group(self) -> PermutationGroup: ...
    def transport_cell(self, cell: SteinerCell) -> SteinerCell: ...
    def verify(self, original: SteinerCategory) -> bool: ...

class FiniteOmegaCategory:
    @property
    def ambient(self) -> SteinerCategory: ...
    @property
    def depth(self) -> int: ...
    @property
    def dimension(self) -> int: ...
    def objects(self) -> list[SteinerCell]: ...
    def exact_cells(self, dimension: int) -> list[SteinerCell]: ...
    def exact_cell_counts(self) -> list[int]: ...
    def strong_steiner_model(self) -> SteinerCategory | None: ...
    def mapping_category(
        self,
        source: SteinerCell,
        target: SteinerCell,
    ) -> FiniteOmegaCategory: ...
    def component_poset(self) -> Poset: ...

class OrientedBasepoint:
    @staticmethod
    def from_pairs(
        category: SteinerCategory,
        pairs: Sequence[tuple[SteinerCell, SteinerCell]],
    ) -> OrientedBasepoint: ...
    @property
    def dimension(self) -> int: ...
    @property
    def homotopy_degree(self) -> int: ...
    @property
    def pairs(self) -> list[tuple[SteinerCell, SteinerCell]]: ...
    @property
    def is_monomorphic(self) -> bool: ...
    def iterated_mapping_category(
        self,
        category: SteinerCategory,
    ) -> FiniteOmegaCategory: ...
    def homotopy_poset(self, category: SteinerCategory) -> Poset: ...

class StreetSimplex:
    @property
    def dimension(self) -> int: ...
    @property
    def images(self) -> list[list[list[int]]]: ...
    @property
    def is_thin(self) -> bool: ...

class StreetNerveSkeleton:
    @property
    def source(self) -> SteinerCategory: ...
    @property
    def max_simplicial_degree(self) -> int: ...
    @property
    def simplex_counts(self) -> list[int]: ...
    @property
    def thin_simplex_counts(self) -> list[int]: ...
    def simplices(self, degree: int) -> list[StreetSimplex] | None: ...
    def faces(self, degree: int, simplex: int) -> list[int] | None: ...
    def degeneracies(self, degree: int, simplex: int) -> list[int] | None: ...
    def verify(self) -> bool: ...

class CategoricalHomologyPresentation:
    @property
    def coefficient_monoid(self) -> str: ...
    @property
    def model(self) -> str: ...
    @property
    def spectrum_model(self) -> str: ...
    @property
    def infinite_loop_model(self) -> str: ...
    @property
    def source(self) -> SteinerCategory: ...
    @property
    def basepoint(self) -> SteinerCell | None: ...
    @property
    def is_reduced(self) -> bool: ...
    def skeleton(self, max_degree: int) -> StreetNerveSkeleton: ...
    def component_poset_slice(
        self,
        particle_number: int,
    ) -> CategoricalHomologyComponentSlice: ...
    def fundamental_poset(
        self,
        source_word: Sequence[SteinerCell],
        target_word: Sequence[SteinerCell],
    ) -> Poset: ...
    def particle_homotopy_poset(
        self,
        factors: Sequence[OrientedBasepoint],
    ) -> Poset: ...

class CategoricalHomologyComponentSlice:
    @property
    def particle_number(self) -> int: ...
    @property
    def object_multisets(self) -> list[list[int]]: ...
    @property
    def poset(self) -> Poset: ...

class SteinerCategory:
    type_id: ClassVar[str]
    def __init__(
        self,
        atom_counts: Sequence[int],
        boundaries: Sequence[Sequence[SignedBoundary]],
    ) -> None: ...
    @staticmethod
    def empty() -> SteinerCategory: ...
    @staticmethod
    def point() -> SteinerCategory: ...
    @staticmethod
    def globe(dimension: int) -> SteinerCategory: ...
    @staticmethod
    def oriental(dimension: int) -> SteinerCategory: ...
    @staticmethod
    def cube(dimension: int) -> SteinerCategory: ...
    def disjoint_union(self, other: SteinerCategory) -> SteinerCategory: ...
    @staticmethod
    def from_json(value: str) -> SteinerCategory: ...
    def to_json(self) -> str: ...
    @property
    def dimension(self) -> int: ...
    @property
    def atom_count(self) -> int: ...
    @property
    def atom_counts(self) -> list[int]: ...
    def atom_count_in_degree(self, degree: int) -> int: ...
    def boundary(self, atom: AtomId) -> SignedBoundary: ...
    def verify(self) -> None: ...
    def precedence_poset(self) -> Poset: ...
    def atom(self, atom: AtomId) -> SteinerCell: ...
    def cell(self, dimension: int, top_atoms: Sequence[int]) -> SteinerCell: ...
    def cell_from_supports(
        self,
        negative_supports: Sequence[Sequence[int]],
        positive_supports: Sequence[Sequence[int]],
    ) -> SteinerCell: ...
    def exact_cells(self, dimension: int) -> list[SteinerCell]: ...
    def cells(self, dimension: int) -> list[SteinerCell]: ...
    def exact_cell_counts(self) -> list[int]: ...
    def mapping_category(
        self,
        source: SteinerCell,
        target: SteinerCell,
    ) -> FiniteOmegaCategory: ...
    def component_poset(self) -> Poset: ...
    def fundamental_poset(
        self,
        source: SteinerCell,
        target: SteinerCell,
    ) -> Poset: ...
    def monomorphic_oriented_basepoints(
        self,
        dimension: int,
    ) -> list[OrientedBasepoint]: ...
    def homotopy_poset(self, basepoint: OrientedBasepoint) -> Poset: ...
    def truncate(self, dimension: int) -> SteinerCategory: ...
    def dual(self, dimensions: Sequence[int]) -> SteinerCategory: ...
    def canonical_label(self) -> SteinerCanonicalLabel: ...
    def canonical_form(self) -> SteinerCategory: ...
    def is_isomorphic(self, other: SteinerCategory) -> bool: ...
    def automorphism_group(self) -> PermutationGroup: ...
    def underlying_chain_complex(self) -> ChainComplex[IntegerRing]: ...
    def polygraphic_homology(self) -> GradedHomology[IntegerRing]: ...
    def polygraphic_homology_invariants(
        self,
    ) -> dict[int, FinitelyGeneratedAbelianGroup]: ...
    def gray_tensor(self, other: SteinerCategory) -> SteinerCategory: ...
    def street_nerve_skeleton(self, max_degree: int) -> StreetNerveSkeleton: ...
    def categorical_homology(self) -> CategoricalHomologyPresentation: ...
    def reduced_categorical_homology(
        self,
        object: SteinerCell,
    ) -> CategoricalHomologyPresentation: ...
    def __eq__(self, other: object) -> bool: ...

__all__: list[str]
