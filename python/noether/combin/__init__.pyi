from collections.abc import Iterator, Sequence
from fractions import Fraction
from typing import Any, ClassVar, Literal, TypeAlias

from noether import IntegerRing
from noether.commalg import Polynomial
from noether.groups import Permutation, PermutationGroup
from noether.homalg import FinitelyGeneratedAbelianGroup
from noether.topology import SimplicialComplex

VertexId: TypeAlias = int
WeightedEdge: TypeAlias = tuple[VertexId, VertexId, int]
BeatPointKind: TypeAlias = Literal["down", "up"]
SymmetricBasis: TypeAlias = Literal[
    "monomial",
    "power_sum",
    "elementary",
    "complete_homogeneous",
    "schur",
]
SymmetricTerm: TypeAlias = tuple[Partition | Sequence[int], int | Fraction]

class Partition:
    type_id: ClassVar[str]
    def __init__(self, parts: Sequence[int]) -> None: ...
    @staticmethod
    def from_json(value: str) -> Partition: ...
    def to_json(self) -> str: ...
    @property
    def parts(self) -> tuple[int, ...]: ...
    @property
    def size(self) -> int: ...
    def conjugate(self) -> Partition: ...
    def hook_lengths(self) -> tuple[int, ...]: ...
    def __eq__(self, other: object) -> bool: ...

class Composition:
    type_id: ClassVar[str]
    def __init__(self, parts: Sequence[int]) -> None: ...
    @staticmethod
    def from_json(value: str) -> Composition: ...
    def to_json(self) -> str: ...
    @property
    def parts(self) -> tuple[int, ...]: ...
    @property
    def size(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...

class Tableau:
    type_id: ClassVar[str]
    def __init__(self, rows: Sequence[Sequence[int]]) -> None: ...
    @staticmethod
    def from_json(value: str) -> Tableau: ...
    def to_json(self) -> str: ...
    @property
    def rows(self) -> tuple[tuple[int, ...], ...]: ...
    @property
    def shape(self) -> Partition: ...
    def content(self, alphabet_size: int) -> tuple[int, ...]: ...
    @staticmethod
    def semistandard(shape: Partition, maximum_entry: int) -> SemistandardTableaux: ...
    @staticmethod
    def rsk(word: Sequence[int]) -> tuple[Tableau, Tableau]: ...
    def __eq__(self, other: object) -> bool: ...

class SemistandardTableaux(Iterator[Tableau]):
    def __init__(self, shape: Partition, maximum_entry: int) -> None: ...
    @property
    def shape(self) -> Partition: ...
    @property
    def maximum_entry(self) -> int: ...
    @property
    def cardinality(self) -> int: ...
    def __iter__(self) -> SemistandardTableaux: ...
    def __next__(self) -> Tableau: ...

class SymmetricFunction:
    type_id: ClassVar[str]
    def __init__(
        self,
        basis: SymmetricBasis,
        terms: Sequence[SymmetricTerm],
    ) -> None: ...
    @staticmethod
    def from_json(value: str) -> SymmetricFunction: ...
    def to_json(self) -> str: ...
    @property
    def basis(self) -> SymmetricBasis: ...
    @property
    def degree(self) -> int | None: ...
    @property
    def terms(self) -> tuple[tuple[Partition, Fraction], ...]: ...
    def convert_basis(self, basis: SymmetricBasis) -> SymmetricFunction: ...
    def __add__(self, rhs: SymmetricFunction) -> SymmetricFunction: ...
    def __sub__(self, rhs: SymmetricFunction) -> SymmetricFunction: ...
    def __mul__(self, rhs: SymmetricFunction) -> SymmetricFunction: ...
    def __eq__(self, other: object) -> bool: ...

