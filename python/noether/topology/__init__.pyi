class _AdmissibleOddPrimaryOperationOrigin(TypedDict):
    kind: Literal["admissible_odd_primary_operation"]
    component: int
    operation: AdmissibleCohomologyOperation
    fundamental_class_lifts_integrally: bool

class _HigherBocksteinOrigin(TypedDict):
    kind: Literal["higher_bockstein"]
    component: int
    primary_exponent: int

class _AdmissibleSteenrodSquareOnHigherPrimaryClassOrigin(TypedDict):
