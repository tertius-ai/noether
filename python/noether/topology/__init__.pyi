_EilenbergMacLaneGeneratorOrigin: TypeAlias = (
    _FundamentalClassOrigin
    | _BocksteinOrigin
    | _PeriodicCyclicClassOrigin
    | _AdmissibleSteenrodSquareOrigin
    | _AdmissibleOddPrimaryOperationOrigin
    | _HigherBocksteinOrigin
