class Graph:
    type_id: ClassVar[str]
    def __init__(
        self,
        n_vertices: int,
        edges: Sequence[Sequence[int]],
        name: str | None = None,
    ) -> None: ...
    @staticmethod
    def from_edges(n: int, edges: Sequence[WeightedEdge], directed: bool) -> Graph: ...
    @staticmethod
    def from_unweighted(
        n: int,
        edges: Sequence[tuple[VertexId, VertexId]],
        directed: bool,
    ) -> Graph: ...
    @staticmethod
    def from_json(value: str) -> Graph: ...
    def to_json(self) -> str: ...
    @property
    def order(self) -> int: ...
    @property
    def edge_count(self) -> int: ...
    @property
    def is_directed(self) -> bool: ...
    @property
    def n_vertices(self) -> int: ...
    @property
    def n_edges(self) -> int: ...
    @property
    def name(self) -> str | None: ...
    @property
    def edges(self) -> list[list[int]]: ...
    @property
    def weighted_edges(self) -> list[WeightedEdge]: ...
    def neighbors(self, vertex: VertexId) -> list[VertexId]: ...
    def degree(self, vertex: VertexId) -> int: ...
    def csr_adjacency(self) -> tuple[list[int], list[VertexId]]: ...
    def subgraph(self, vertices: Sequence[VertexId]) -> tuple[Graph, list[VertexId]]: ...
    def transpose(self) -> Graph: ...
    def bfs(self, source: VertexId) -> GraphTraversal: ...
    def dfs(self, source: VertexId) -> GraphTraversal: ...
    def connected_components(self) -> ConnectedComponents: ...
    def shortest_path(self, source: VertexId, target: VertexId) -> ShortestPath | None: ...
    def canonical_label(self) -> CanonicalLabel: ...
    def automorphism_group(self) -> PermutationGroup: ...
    def laplacian(self) -> list[list[int]]: ...
    def reduced_laplacian(self, delete_vertex: VertexId = 0) -> list[list[int]]: ...
    def laplacian_spectrum(self) -> list[float]: ...
    def degree_sequence(self) -> list[int]: ...
    def __eq__(self, other: object) -> bool: ...

class CanonicalLabel:
    @property
    def graph(self) -> Graph: ...
    @property
    def labeling(self) -> Permutation: ...
    @property
    def automorphism_group(self) -> PermutationGroup: ...
    def verify(self, original: Graph) -> bool: ...

class GraphTraversal:
    @property
    def order(self) -> list[VertexId]: ...
    @property
    def pred(self) -> list[VertexId | None]: ...
    @property
    def depth(self) -> list[int | None]: ...
    def path_to(self, target: VertexId) -> list[VertexId] | None: ...

class ShortestPath:
    @property
    def distance(self) -> int: ...
    @property
    def path(self) -> list[VertexId]: ...

class ConnectedComponents:
    @property
    def count(self) -> int: ...
    @property
    def label(self) -> list[int]: ...
    def members(self, component: int) -> list[VertexId]: ...

class GraphLabeling:
    def __init__(
        self,
        graph: Graph,
        vertex: Sequence[Any],
        edge: Sequence[Any],
    ) -> None: ...
    def vertex_label(self, vertex: VertexId) -> Any: ...
    def edge_label(self, edge: int) -> Any: ...
    def vertex_labels(self) -> list[Any]: ...
    def edge_labels(self) -> list[Any]: ...
    def set_vertex_label(self, vertex: VertexId, label: Any) -> None: ...
    def subgraph(
        self,
        original: Graph,
        subgraph: Graph,
        vertex_map: Sequence[VertexId],
    ) -> GraphLabeling: ...
    def transpose(self) -> GraphLabeling: ...

