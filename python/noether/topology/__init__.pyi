class AdmissibleCohomologyOperation:
    @staticmethod
    def mod_two(sequence: list[int]) -> AdmissibleCohomologyOperation: ...
    @staticmethod
    def odd_primary(
        prime: int, bocksteins: list[bool], reduced_powers: list[int]
    ) -> AdmissibleCohomologyOperation: ...
    @staticmethod
    def identity(prime: int) -> AdmissibleCohomologyOperation: ...
    @staticmethod
    def steenrod_square(square: int) -> AdmissibleCohomologyOperation: ...
    @staticmethod
    def reduced_power(prime: int, power: int) -> AdmissibleCohomologyOperation: ...
    @staticmethod
    def bockstein_reduced_power(prime: int, power: int) -> AdmissibleCohomologyOperation: ...
    @property
    def prime(self) -> int: ...
    @property
    def square_sequence(self) -> list[int] | None: ...
    @property
    def bocksteins(self) -> list[bool] | None: ...
    @property
    def reduced_powers(self) -> list[int] | None: ...
    def is_identity(self) -> bool: ...
    @property
    def degree_shift(self) -> int: ...
    @property
    def excess(self) -> int: ...
    @property
    def display_name(self) -> str: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> AdmissibleCohomologyOperation: ...

class _DegenerateFace(TypedDict):
    simplex_dimension: int
    simplex: int
    surjection: list[int]

_SimplicialFaceData: TypeAlias = int | _DegenerateFace

class _FundamentalClassOrigin(TypedDict):
    kind: Literal["fundamental_class"]
    component: int

class _BocksteinOrigin(TypedDict):
    kind: Literal["bockstein"]
