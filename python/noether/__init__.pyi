from collections.abc import Iterable
from dataclasses import dataclass
from fractions import Fraction as _Fraction
from typing import Any, ClassVar, Generic, Literal, Protocol, TypeVar

from noether.commalg import Ideal, ResidueClass, ResidueRing
from noether.numthy import FiniteField, FiniteFieldElement

_Element = TypeVar("_Element")

class NoetherError(Exception): ...

class UnsupportedOperationError(NoetherError):
    operation: str
    context: str
    supported_contexts: tuple[str, ...]
    detail: str | None

class ContextMismatchError(NoetherError):
    expected: str
    actual: str

class VerificationError(NoetherError):
    kind: Literal["context_mismatch", "invalid_witness"]
    expected: str
    actual: str
    claim: str

class OperationDescription:
    name: str
    domain: str
    kind: str
    summary: str
    signatures: tuple[str, ...]
    input_schemas: tuple[dict[str, Any], ...]
    result_schemas: tuple[dict[str, Any], ...]
    determinism: Literal["deterministic", "seeded"]
    documentation: str
    type_id: str | None
    supported_rings: tuple[str, ...]
    locations: tuple[str, ...]
    algorithms: tuple[str, ...]
    backends: tuple[str, ...]
    validity: tuple[str, ...]
    evidence: tuple[str, ...]
    example: str | None
    errors: tuple[str, ...]
    releases_gil: bool
    @property
    def input_schema(self) -> dict[str, Any]: ...
    @property
    def result_schema(self) -> dict[str, Any]: ...

class _BackendStatus:
    name: str
    kind: Literal["native", "library", "kernel", "subprocess"]
    compiled: bool
    available: bool
    detail: str

class LocalConcurrency:
    schedulable_threads: int
    requested_threads: int | None
    effective_threads: int
    override_valid: bool
    affinity_source: str
    override_name: str
    phase_owner: str

@dataclass(frozen=True)
class MpiRuntime:
    library_version: str
    world_size: int
    mpi_rank: int
    thread_support: str

class Capabilities:
    version: str
    domains: tuple[str, ...]
    types: tuple[str, ...]
    operations: tuple[str, ...]
    values: tuple[str, ...]
    backends: tuple[_BackendStatus, ...]
    local_concurrency: LocalConcurrency
    compiled_features: tuple[str, ...]
    mpi_runtime: MpiRuntime | None
    def supports(self, operation: str) -> bool: ...
    def backend(self, name: str) -> _BackendStatus: ...

def describe(target: str | object) -> OperationDescription: ...
def capabilities() -> Capabilities: ...

class BezoutIdentity(Generic[_Element]):
    type_id: ClassVar[str]
    @property
    def ring(self) -> IntegerRing | RationalField: ...
    @property
    def gcd(self) -> _Element: ...
    @property
    def coefficient_a(self) -> _Element: ...
    @property
    def coefficient_b(self) -> _Element: ...
    def verify(
        self,
        ring: Ring[_Element],
        left: _Element,
        right: _Element,
    ) -> None: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> BezoutIdentity[int] | BezoutIdentity[_Fraction]: ...

class Ring(Protocol[_Element]):
    def zero(self) -> _Element: ...
    def one(self) -> _Element: ...
    def __call__(self, value: _Element) -> _Element: ...

class Field(Ring[_Element], Protocol[_Element]):
    def inverse(self, value: _Element) -> _Element: ...

class IntegerRationalEmbedding:
    type_id: ClassVar[str]
    @property
    def source(self) -> IntegerRing: ...
    @property
    def target(self) -> RationalField: ...
    def apply(self, value: int) -> _Fraction: ...
    def verify(self) -> None: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> IntegerRationalEmbedding: ...
    def __call__(self, value: int) -> _Fraction: ...

class IntegerReduction:
    type_id: ClassVar[str]
    @property
    def source(self) -> IntegerRing: ...
    @property
    def target(self) -> ResidueRing: ...
    def apply(self, value: int) -> ResidueClass: ...
    def verify(self) -> None: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> IntegerReduction: ...
    def __call__(self, value: int) -> ResidueClass: ...

class IntegerFiniteFieldMap:
    type_id: ClassVar[str]
    @property
    def source(self) -> IntegerRing: ...
    @property
    def target(self) -> FiniteField: ...
    def apply(self, value: int) -> FiniteFieldElement: ...
    def verify(self) -> None: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> IntegerFiniteFieldMap: ...
    def __call__(self, value: int) -> FiniteFieldElement: ...

class PrimeSubfieldEmbedding:
    type_id: ClassVar[str]
    @property
    def source(self) -> FiniteField: ...
    @property
    def target(self) -> FiniteField: ...
    def apply(self, value: FiniteFieldElement) -> FiniteFieldElement: ...
    def verify(self) -> None: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> PrimeSubfieldEmbedding: ...
    def __call__(self, value: FiniteFieldElement) -> FiniteFieldElement: ...

class IntegerRing:
    type_id: ClassVar[str]
    def zero(self) -> int: ...
    def one(self) -> int: ...
    def __call__(self, value: int) -> int: ...
    def gcd(self, left: int, right: int) -> int: ...
    def extended_gcd(self, left: int, right: int) -> BezoutIdentity[int]: ...
    def rational_embedding(self) -> IntegerRationalEmbedding: ...
    def reduction(self, target: ResidueRing) -> IntegerReduction: ...
    def finite_field_map(self, target: FiniteField) -> IntegerFiniteFieldMap: ...
    def ideal(self, generators: Iterable[int]) -> Ideal[IntegerRing]: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> IntegerRing: ...

class RationalField:
    type_id: ClassVar[str]
    def zero(self) -> _Fraction: ...
    def one(self) -> _Fraction: ...
    def __call__(self, value: int | _Fraction) -> _Fraction: ...
    def inverse(self, value: int | _Fraction) -> _Fraction: ...
    def gcd(self, left: int | _Fraction, right: int | _Fraction) -> _Fraction: ...
    def extended_gcd(
        self,
        left: int | _Fraction,
        right: int | _Fraction,
    ) -> BezoutIdentity[_Fraction]: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> RationalField: ...

class RealBallField:
    type_id: ClassVar[str]
    def __init__(self, precision: int) -> None: ...
    @property
    def precision(self) -> int: ...
    def zero(self) -> RealBall: ...
    def one(self) -> RealBall: ...
    def __call__(self, value: int | _Fraction) -> RealBall: ...
    def interval(self, lower: int | _Fraction, upper: int | _Fraction) -> RealBall: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> RealBallField: ...

class RealBall:
    type_id: ClassVar[str]
    @property
    def field(self) -> RealBallField: ...
    @property
    def is_exact(self) -> bool: ...
    def contains_zero(self) -> bool: ...
    def overlaps(self, other: RealBall) -> bool: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, value: str) -> RealBall: ...
    def __add__(self, other: RealBall | int | _Fraction) -> RealBall: ...
    def __radd__(self, other: int | _Fraction) -> RealBall: ...
    def __sub__(self, other: RealBall | int | _Fraction) -> RealBall: ...
    def __rsub__(self, other: int | _Fraction) -> RealBall: ...
    def __mul__(self, other: RealBall | int | _Fraction) -> RealBall: ...
    def __rmul__(self, other: int | _Fraction) -> RealBall: ...
    def __neg__(self) -> RealBall: ...
    def __pow__(self, exponent: int, modulus: None = None) -> RealBall: ...

class ComplexBallField:
    type_id: ClassVar[str]
    def __init__(self, precision: int) -> None: ...
