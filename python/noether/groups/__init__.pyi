from collections.abc import Iterator, Sequence
from typing import Any, ClassVar, Literal, Protocol, TypeAlias, runtime_checkable

from noether import IntegerRing
from noether.combin import Partition
from noether.commalg import Polynomial, PowerSeries
from noether.homalg import (
    FiniteAbelianGroupCohomologyPresentation,
    FiniteAbelianGroupIntegralCohomologyPresentation,
    FiniteCyclicGroupIntegralCohomologyPresentation,
    FiniteGroupCohomologyTruncation,
    FiniteGroupIntegralCohomologyTruncation,
)
from noether.numthy import FiniteField

WeightBasisConvention: TypeAlias = Literal["standard", "type_a_fundamental"]
Weight: TypeAlias = Sequence[int]
WeightTerm: TypeAlias = tuple[Weight, int]

class WeightLattice:
    type_id: ClassVar[str]
    def __init__(self, basis_names: Sequence[str]) -> None: ...
    @staticmethod
    def standard(rank: int) -> WeightLattice: ...
    @staticmethod
    def type_a(n: int) -> WeightLattice: ...
    @staticmethod
    def from_json(value: str) -> WeightLattice: ...
    @property
    def rank(self) -> int: ...
    @property
    def basis_names(self) -> list[str]: ...
    @property
    def basis_convention(self) -> WeightBasisConvention: ...
    @property
    def type_a_degree(self) -> int | None: ...
    def homomorphism(
        self, target: WeightLattice, basis_images: Sequence[Weight]
    ) -> WeightLatticeMap: ...
    def identity_map(self) -> WeightLatticeMap: ...
    def to_json(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...

class WeightLatticeMap:
    type_id: ClassVar[str]
    @staticmethod
    def from_json(value: str) -> WeightLatticeMap: ...
    @property
    def source(self) -> WeightLattice: ...
    @property
    def target(self) -> WeightLattice: ...
    @property
    def basis_images(self) -> tuple[tuple[int, ...], ...]: ...
    def apply(self, weight: Weight) -> tuple[int, ...]: ...
    def then(self, next: WeightLatticeMap) -> WeightLatticeMap: ...
    def to_json(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...

class WeightCharacter:
    type_id: ClassVar[str]
    def __init__(self, lattice: WeightLattice, terms: Sequence[WeightTerm]) -> None: ...
    @staticmethod
    def from_json(value: str) -> WeightCharacter: ...
    @property
    def lattice(self) -> WeightLattice: ...
    @property
    def terms(self) -> tuple[tuple[tuple[int, ...], int], ...]: ...
    @property
    def dimension(self) -> int: ...
    def multiplicity(self, weight: Weight) -> int: ...
    def checked_add(self, other: WeightCharacter) -> WeightCharacter: ...
    def tensor(self, other: WeightCharacter) -> WeightCharacter: ...
    def dual(self) -> WeightCharacter: ...
    def restrict(self, map: WeightLatticeMap) -> WeightCharacter: ...
    def chern_class(self, degree: int) -> Polynomial[IntegerRing]: ...
    def total_chern_class(self, maximum_degree: int) -> PowerSeries[IntegerRing]: ...
    def verify(self) -> None: ...
    def to_json(self) -> str: ...
    def __add__(self, other: WeightCharacter) -> WeightCharacter: ...
    def __mul__(self, other: WeightCharacter) -> WeightCharacter: ...
    def __eq__(self, other: object) -> bool: ...

class PolynomialGlRepresentation:
    type_id: ClassVar[str]
    def __init__(self, rank: int, partition: Partition) -> None: ...
    @staticmethod
    def from_json(value: str) -> PolynomialGlRepresentation: ...
    @property
    def rank(self) -> int: ...
    @property
    def partition(self) -> Partition: ...
    @property
    def highest_weight(self) -> tuple[int, ...]: ...
    @property
    def degree(self) -> int: ...
    @property
    def weyl_dimension(self) -> int: ...
    @property
    def scalar_central_character(self) -> int: ...
    def gl_character(self) -> WeightCharacter: ...
    def sl_character(self) -> WeightCharacter: ...
    def descends_to_sl_quotient(self, order: int) -> bool: ...
    def second_chern_index(self) -> int: ...
    def second_chern_index_from_weights(self) -> int: ...
    def verify_second_chern_index(self) -> None: ...
    def to_json(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...

class Permutation:
    type_id: ClassVar[str]
    @staticmethod
    def from_images(images: Sequence[int]) -> Permutation: ...
    @staticmethod
    def identity(degree: int) -> Permutation: ...
    @property
    def degree(self) -> int: ...
    @property
    def is_identity(self) -> bool: ...
    @property
    def order(self) -> int: ...
    @property
    def images(self) -> list[int]: ...
    def apply(self, point: int) -> int: ...
    def __call__(self, point: int) -> int: ...
    def compose(self, other: Permutation) -> Permutation: ...
    def __mul__(self, other: Permutation) -> Permutation: ...
    def inverse(self) -> Permutation: ...

@runtime_checkable
class FiniteGroup(Protocol):
    @property
    def order(self) -> int: ...
    def identity(self) -> Any: ...
    def contains(self, value: Any) -> bool: ...
    def multiply(self, left: Any, right: Any) -> Any: ...
    def inverse(self, value: Any) -> Any: ...

class PermutationGroup:
    type_id: ClassVar[str]
    @staticmethod
    def from_generators(degree: int, generators: Sequence[Permutation]) -> PermutationGroup: ...
    @staticmethod
    def from_generators_randomized(
        degree: int,
        generators: Sequence[Permutation],
        seed: int,
        stabilize: int,
    ) -> PermutationGroup: ...
    @staticmethod
    def base_and_strong_generating_set(
        degree: int, generators: Sequence[Permutation]
    ) -> tuple[list[int], list[Permutation]]: ...
    @staticmethod
    def group_order(degree: int, generators: Sequence[Permutation]) -> int: ...
    @property
    def degree(self) -> int: ...
    @property
    def generators(self) -> list[Permutation]: ...
    @property
    def base(self) -> list[int]: ...
    @property
    def strong_generating_set(self) -> list[Permutation]: ...
    @property
    def order(self) -> int: ...
    @property
    def is_transitive(self) -> bool: ...
    @property
    def is_solvable(self) -> bool: ...
    @property
    def is_nilpotent(self) -> bool: ...
    @property
    def is_perfect(self) -> bool: ...
    def contains(self, element: Permutation) -> bool: ...
    def __contains__(self, element: Permutation) -> bool: ...
    def identity(self) -> Permutation: ...
    def multiply(self, left: Permutation, right: Permutation) -> Permutation: ...
    def inverse(self, value: Permutation) -> Permutation: ...
    def modular_cohomology(
        self, prime: int, max_degree: int
    ) -> FiniteGroupCohomologyTruncation: ...
    def integral_cohomology(self, max_degree: int) -> FiniteGroupIntegralCohomologyTruncation: ...
    def abelian_invariant_factors(self) -> list[int]: ...
    def abelianization_invariant_factors(self) -> list[int]: ...
    def complete_abelian_modular_cohomology(
        self, field: FiniteField
    ) -> FiniteAbelianGroupCohomologyPresentation: ...
    def complete_abelian_integral_cohomology(
        self,
    ) -> FiniteAbelianGroupIntegralCohomologyPresentation: ...
    def complete_cyclic_integral_cohomology(
        self,
    ) -> FiniteCyclicGroupIntegralCohomologyPresentation: ...
    def sylow_subgroup(self, prime: int) -> PermutationGroup: ...
    def intersection(self, other: PermutationGroup) -> PermutationGroup: ...
    def sift(self, element: Permutation) -> tuple[Permutation, bool]: ...
    def orbit(self, point: int) -> list[int]: ...
    def orbit_of_subset(self, points: Sequence[int]) -> SubsetOrbit: ...
    def orbits_on_subsets(self, size: int) -> list[SubsetOrbit]: ...
    def orbits_on_pairs(self) -> list[SubsetOrbit]: ...
    def pair_orbits(self, left_seed: int, right_seed: int) -> list[PairOrbit]: ...
    def double_cosets(
        self, left: PermutationGroup, right: PermutationGroup
    ) -> list[DoubleCoset]: ...
    def double_coset_triangle(
        self, subgroups: Sequence[PermutationGroup]
    ) -> list[list[list[DoubleCoset]]]: ...
    def transversal(self, point: int) -> Transversal: ...
    def schreier_tree(self, point: int) -> SchreierTree: ...
    def schreier_generators(self, point: int) -> list[SchreierGenerator]: ...
    def stabilizer(self, point: int) -> PermutationGroup: ...
    def pointwise_stabilizer(self, points: Sequence[int]) -> PermutationGroup: ...
    def orbit_stabilizer(self, point: int) -> OrbitStabilizer: ...
    def stabilizer_chain(self) -> StabilizerChain: ...
    def iterate_elements(self) -> Iterator[Permutation]: ...
    def conjugacy_classes(self) -> list[ConjugacyClass]: ...
    def uniform_random_element(self, seed: int) -> RandomElement: ...
    def conjugating_element(self, other: PermutationGroup) -> Permutation | None: ...
    def embeds_up_to_conjugacy(self, over: PermutationGroup) -> Permutation | None: ...
    def normalizer_in_symmetric(self) -> PermutationGroup: ...
    def normalizer(self, subgroup: PermutationGroup) -> PermutationGroup: ...
    def set_stabilizer(self, points: Sequence[int]) -> PermutationGroup: ...

class SubsetOrbit:
    type_id: ClassVar[str]
    @property
    def degree(self) -> int: ...
    @property
    def subset_size(self) -> int: ...
    @property
    def representative(self) -> list[int]: ...
    @property
    def elements(self) -> list[list[int]]: ...
    @property
    def size(self) -> int: ...
    def verify(self, group: PermutationGroup) -> None: ...

class PairOrbit:
    type_id: ClassVar[str]
    @property
    def degree(self) -> int: ...
    @property
    def left_seed(self) -> int: ...
    @property
    def right_seed(self) -> int: ...
    @property
    def representative(self) -> list[int]: ...
    @property
    def anchored_suborbits(self) -> list[list[int]]: ...
    @property
    def size(self) -> int: ...
    @property
    def same_point_orbit(self) -> bool: ...
    def verify(self, group: PermutationGroup) -> None: ...

class DoubleCoset:
    type_id: ClassVar[str]
    @property
    def degree(self) -> int: ...
    @property
    def representative(self) -> Permutation: ...
    @property
    def inverse_representative(self) -> Permutation | None: ...
    @property
    def right_coset_count(self) -> int: ...
    @property
    def size(self) -> int: ...
    def verify(
        self,
        ambient: PermutationGroup,
        left: PermutationGroup,
        right: PermutationGroup,
    ) -> None: ...

class ConjugacyClass:
    type_id: ClassVar[str]
    @property
    def group(self) -> PermutationGroup: ...
    @property
    def representative(self) -> Permutation: ...
    @property
    def elements(self) -> list[Permutation]: ...
    @property
    def size(self) -> int: ...
    def centralizer(self) -> PermutationGroup: ...
    def verify(self) -> None: ...

class Transversal:
    @property
    def base(self) -> int: ...
    @property
    def orbit(self) -> list[int]: ...
    @property
    def reps(self) -> list[Permutation]: ...

class SchreierTree:
    @property
    def root(self) -> int: ...
    @property
    def orbit(self) -> list[int]: ...
    @property
    def pred(self) -> list[tuple[int, int] | None]: ...
    @property
    def generators_used(self) -> list[Permutation]: ...
    def contains(self, point: int) -> bool: ...

class StabilizerChainStep:
    @property
    def base(self) -> int: ...
    @property
    def generators(self) -> list[Permutation]: ...
    @property
    def orbit(self) -> list[int]: ...
    @property
    def transversal(self) -> list[Permutation]: ...

class StabilizerChain:
    @property
    def steps(self) -> list[StabilizerChainStep]: ...
    def __len__(self) -> int: ...

class SchreierGenerator:
    @property
    def coset_index(self) -> int: ...
    @property
    def generator_index(self) -> int: ...
    @property
    def perm(self) -> Permutation: ...

class OrbitStabilizer:
    @property
    def orbit(self) -> list[int]: ...
    @property
    def stabilizer(self) -> PermutationGroup: ...

class RandomElement:
    @property
    def element(self) -> Permutation: ...
    @property
    def seed(self) -> int: ...
