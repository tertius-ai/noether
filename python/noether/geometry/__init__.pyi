from collections.abc import Iterable, Sequence
from fractions import Fraction
from typing import ClassVar, Protocol, runtime_checkable

@runtime_checkable
class Metric(Protocol):
    def __len__(self) -> int: ...
    def distance(self, i: int, j: int) -> float: ...
    def enclosing_radius(self) -> float: ...

class PointCloud:
    type_id: ClassVar[str]
    def __init__(self, points: Sequence[Sequence[float]]) -> None: ...
    @staticmethod
    def from_json(value: str) -> PointCloud: ...
    def to_json(self) -> str: ...
    def __len__(self) -> int: ...
    def is_empty(self) -> bool: ...
    @property
    def ambient_dimension(self) -> int: ...
    @property
    def points(self) -> list[list[float]]: ...
    def __getitem__(self, index: int) -> list[float]: ...
    def distance(self, i: int, j: int) -> float: ...
    def enclosing_radius(self) -> float: ...
    def affine_rank(self) -> int: ...
    def project_to_affine_hull(self) -> PointCloud: ...
    def delaunay(self) -> Triangulation: ...
    def regular_triangulation(self, weights: Sequence[float]) -> Triangulation: ...

class Triangulation:
    type_id: ClassVar[str]
    @staticmethod
    def from_json(value: str) -> Triangulation: ...
    def to_json(self) -> str: ...
    @property
    def dimension(self) -> int: ...
    @property
    def dim(self) -> int: ...
    @property
    def points(self) -> list[list[float]]: ...
    @property
    def simplices(self) -> list[list[int]]: ...
    @property
    def cells(self) -> list[list[int]]: ...
    @property
    def n_cells(self) -> int: ...
    @property
    def weighted(self) -> bool: ...
    @property
    def weights(self) -> list[float] | None: ...
    def circumcentres(self) -> list[tuple[list[float], float]]: ...
    def verify(self) -> None: ...

class Polytope:
    type_id: ClassVar[str]
    @staticmethod
    def from_vertices(points: Sequence[Sequence[int | Fraction]]) -> Polytope: ...
    @staticmethod
    def from_halfspaces(
        normals: Sequence[Sequence[int | Fraction]],
        rhs: Sequence[int | Fraction],
    ) -> Polytope: ...
    @staticmethod
    def from_json(value: str) -> Polytope: ...
    def to_json(self) -> str: ...
    @property
    def ambient_dimension(self) -> int: ...
    @property
    def dimension(self) -> int: ...
    @property
    def is_full_dimensional(self) -> bool: ...
    @property
    def vertices(self) -> list[list[Fraction]]: ...
    @property
    def facets(self) -> list[tuple[list[Fraction], Fraction]]: ...
    @property
    def vertex_facet_incidence(self) -> list[list[int]]: ...
    @property
    def f_vector(self) -> list[int]: ...
    def face_lattice(self) -> list[tuple[int, list[int]]]: ...
    def face_lattice_covers(self) -> list[tuple[int, int]]: ...
    def is_vertex(self, point: Sequence[int | Fraction]) -> bool: ...
    def is_facet(self, normal: Sequence[int | Fraction], rhs: int | Fraction) -> bool: ...
    def verify(self) -> None: ...

def convex_hull(
    points: Iterable[Iterable[int | Fraction]],
) -> Polytope: ...
def delaunay(points: PointCloud | Iterable[Iterable[float]]) -> Triangulation: ...
def regular_triangulation(
    points: PointCloud | Iterable[Iterable[float]], weights: Sequence[float]
) -> Triangulation: ...
