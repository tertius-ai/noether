)
QuotientScalar: TypeAlias = QuotientElement[RationalField] | QuotientElement[FiniteField]

class IntegralLineConfiguration:
    type_id: ClassVar[str]
    def __init__(self, ambient_rank: int, vectors: Iterable[Iterable[int]]) -> None: ...
    @property
    def ambient_rank(self) -> int: ...
    @property
    def line_count(self) -> int: ...
    @property
    def vectors(self) -> tuple[tuple[int, ...], ...]: ...
    @property
    def span_rank(self) -> int: ...
    @property
    def is_spanning(self) -> bool: ...
    @property
    def perfection_rank(self) -> int: ...
    @property
    def is_rank_one_independent(self) -> bool: ...
    @property
    def rank_one_matrix(self) -> Matrix[IntegerRing]: ...
    @property
    def barycenter_form(self) -> Matrix[IntegerRing]: ...
    def transform(self, transformation: Matrix[IntegerRing]) -> IntegralLineConfiguration: ...
    def induced_permutation(self, transformation: Matrix[IntegerRing]) -> Permutation: ...
    def induced_signed_permutation(self, transformation: Matrix[IntegerRing]) -> Permutation: ...
    def orientation_sign(self, transformation: Matrix[IntegerRing]) -> int: ...
    def automorphism_group(self) -> IntegralLineAutomorphismGroup: ...
    def equivalence_to(
        self,
        target: IntegralLineConfiguration,
        *,
        target_automorphisms: IntegralLineAutomorphismGroup | None = None,
    ) -> IntegralLineEquivalence | None: ...
    def realize_minimum(self, *, max_iterations: int = 50) -> MinimumRealization: ...
    def complete_minimum(self, *, max_iterations: int = 50) -> MinimumCompletion: ...
    def __eq__(self, other: object) -> bool: ...

