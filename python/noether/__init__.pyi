    def __sub__(self, other: ComplexBall | int | _Fraction) -> ComplexBall: ...
    def __rsub__(self, other: int | _Fraction) -> ComplexBall: ...
    def __mul__(self, other: ComplexBall | int | _Fraction) -> ComplexBall: ...
    def __rmul__(self, other: int | _Fraction) -> ComplexBall: ...
    def __neg__(self) -> ComplexBall: ...
